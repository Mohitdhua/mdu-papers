---
import BaseLayout from '@layouts/BaseLayout.astro';
import MduPaperTemplate, { type PaperData } from '@components/MduPaperTemplate.astro';

// Sample AI-generated Authentic MDU Model Question Paper Data
const dbmsMockPaper: PaperData = {
  paperId: '24151-MOCK',
  paperCode: 'CSE-301-F',
  totalPages: 2,
  totalQuestions: 9,
  degreeCourse: 'B.Tech. 5th Semester Examination',
  branch: 'Computer Science & Engineering',
  subjectName: 'DATABASE MANAGEMENT SYSTEMS',
  paperName: 'Model Test Paper (AI Generated)',
  examSession: 'December 2024 / May 2025',
  timeAllowed: '3 Hours',
  maxMarks: 80,
  compulsoryNote: 'Attempt Five questions in all, selecting one question from each Section. Question No. 1 is compulsory. All questions carry equal marks.',
  sections: [
    {
      name: 'Compulsory Section',
      note: 'Question No. 1 is Compulsory',
      questions: [
        {
          id: 1,
          qNum: '1',
          title: 'Answer the following short answer questions:',
          marks: 16,
          subParts: [
            {
              label: 'a',
              text: 'Differentiate between Physical Data Independence and Logical Data Independence.',
              marks: 3,
              solution: 'Logical Data Independence is the capacity to change the conceptual schema without having to change external schemas. Physical Data Independence is the capacity to change the internal schema (storage structures, indexing) without altering conceptual schemas.'
            },
            {
              label: 'b',
              text: 'What is a Foreign Key? Explain with a suitable example.',
              marks: 3,
              solution: 'A Foreign Key is a field (or collection of fields) in one table that uniquely identifies a row of another table or the same table (referencing the Primary Key). Example: `Student.dept_id` references `Department.dept_id`.'
            },
            {
              label: 'c',
              text: 'State the purpose of 3NF (Third Normal Form) in relational databases.',
              marks: 3,
              solution: '3NF removes transitive dependencies (where a non-prime attribute depends on another non-prime attribute). A relation is in 3NF if it is in 2NF and no non-prime attribute is transitively dependent on any candidate key.'
            },
            {
              label: 'd',
              text: 'What are ACID properties in Database Transaction Management?',
              marks: 3,
              solution: 'ACID stands for Atomicity (all or nothing execution), Consistency (maintains database invariants), Isolation (concurrent transactions execute independently), and Durability (committed changes persist permanently).'
            },
            {
              label: 'e',
              text: 'Define B+ Tree and explain why it is preferred over B-Tree for indexing.',
              marks: 4,
              solution: 'In a B+ Tree, data pointers are stored ONLY in leaf nodes, and leaf nodes are linked sequentially. This allows faster range queries, higher fan-out in internal nodes, and predictable search performance compared to B-Trees.'
            }
          ]
        }
      ]
    },
    {
      name: 'SECTION - A',
      note: 'Attempt any one question',
      questions: [
        {
          id: 2,
          qNum: '2',
          text: '(a) Explain the Three-Schema Architecture of a Database Management System with a neat diagram. Discuss its advantages.\n(b) Construct an ER Diagram for a University Examination System showing Entity sets, Attributes, and Relationships with cardinality ratios.',
          marks: 16,
          solution: 'Part (a): Three-Schema Architecture consists of External Level (User Views), Conceptual Level (Logical structure of whole DB), and Internal Level (Physical storage). Advantages include data independence, security, and multiple user views.\nPart (b): Entity Sets: Student(roll_no, name), Exam(exam_id, date), Course(course_code). Relationships: Appears_In (Student to Exam 1:N), Enrolled_In (Student to Course N:M).'
        },
        {
          id: 3,
          qNum: '3',
          text: 'Explain Relational Algebra operators in detail. Given relations R(A, B) and S(B, C), illustrate Selection (σ), Projection (π), Natural Join (⋈), and Division (÷) operators with concrete examples.',
          marks: 16,
          solution: 'Relational algebra is a procedural query language. Selection (σ) filters rows based on predicate. Projection (π) selects specific columns. Natural Join (⋈) combines tuples based on common attribute values. Division (÷) finds tuples in R that match all tuples in S.'
        }
      ]
    },
    {
      name: 'SECTION - B',
      note: 'Attempt any one question',
      questions: [
        {
          id: 4,
          qNum: '4',
          text: '(a) What is Normalization? Explain 1NF, 2NF, 3NF, and BCNF with suitable relational schema examples.\n(b) Given relation R(A,B,C,D,E) with FDs {A->B, BC->D, E->C}. Find all Candidate Keys and determine the highest Normal Form of R.',
          marks: 16,
          solution: 'Candidate Key computation: Closure of (A,E)+ = {A,E,B,C,D}. Hence (A,E) is a Candidate Key. Since E->C has non-key left side and C is non-prime, R has transitive dependency and is in 1NF.'
        },
        {
          id: 5,
          qNum: '5',
          text: 'Write SQL queries for the following schema: \nEmployee(emp_id, emp_name, dept_name, salary)\nWorks(emp_id, project_name, location)\n(i) Find top 3 highest paid employees in CSE department.\n(ii) Find employees who work on all projects located in Gurgaon.\n(iii) Increase salary by 10% for employees working on project "AI-Model".',
          marks: 16,
          solution: '(i) `SELECT * FROM Employee WHERE dept_name="CSE" ORDER BY salary DESC LIMIT 3;` \n(ii) `SELECT emp_name FROM Employee E WHERE NOT EXISTS (SELECT project_name FROM Works WHERE location="Gurgaon" EXCEPT SELECT project_name FROM Works W WHERE W.emp_id = E.emp_id);` \n(iii) `UPDATE Employee SET salary = salary * 1.10 WHERE emp_id IN (SELECT emp_id FROM Works WHERE project_name="AI-Model");`'
        }
      ]
    },
    {
      name: 'SECTION - C',
      note: 'Attempt any one question',
      questions: [
        {
          id: 6,
          qNum: '6',
          text: '(a) What is Concurrency Control? Describe Two-Phase Locking (2PL) Protocol (Growing Phase and Shrinking Phase) and Strict 2PL.\n(b) Explain Deadlock Detection, Prevention, and Recovery strategies in DBMS.',
          marks: 16,
          solution: '2PL Protocol ensures serializability by restricting lock acquisitions. Growing Phase: Locks acquired, none released. Shrinking Phase: Locks released, none acquired. Strict 2PL requires exclusive locks to be held until transaction commits/aborts to prevent cascading rollbacks.'
        },
        {
          id: 7,
          qNum: '7',
          text: 'Describe Database Recovery Techniques based on Log Records. Compare Deferred Update (NO-UNDO/REDO) vs Immediate Update (UNDO/REDO) algorithms with Checkpointing.',
          marks: 16,
          solution: 'Deferred Update delays physical database updates until transaction reaches commit point (requires REDO only). Immediate Update writes changes to disk immediately (requires both UNDO and REDO). Checkpointing creates safe points to minimize log scanning during crash recovery.'
        }
      ]
    },
    {
      name: 'SECTION - D',
      note: 'Attempt any one question',
      questions: [
        {
          id: 8,
          qNum: '8',
          text: '(a) Explain Primary, Secondary, and Clustering Indexing with suitable diagrams.\n(b) Describe RAID Levels (RAID 0, RAID 1, RAID 5, RAID 10) detailing performance and fault tolerance trade-offs.',
          marks: 16,
          solution: 'Primary Index: Built on ordered key field. Clustering Index: Built on ordered non-key field. Secondary Index: Built on unordered fields. RAID 0 (Striping - fast, no redundancy), RAID 1 (Mirroring - 100% redundancy), RAID 5 (Parity - fault tolerant with N-1 capacity), RAID 10 (Striped Mirrors).'
        },
        {
          id: 9,
          qNum: '9',
          text: 'Write short notes on any TWO of the following:\n(i) Distributed Databases and 2-Phase Commit (2PC) Protocol\n(ii) NoSQL Databases vs Relational Databases\n(iii) Query Optimization using Heuristic Rules & Cost Estimation',
          marks: 16,
          solution: '(i) 2PC Protocol ensures atomic commit across distributed nodes via Prepare and Commit phases.\n(ii) NoSQL databases (MongoDB, Cassandra) offer dynamic schema, horizontal scalability, and eventual consistency compared to ACID relational databases.'
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="MDU AI Mock Test Paper - Database Management Systems (CSE-301-F) | mdupapers"
  description="Practice authentic AI-generated MDU B.Tech 5th Semester Database Management Systems (DBMS) Model Question Paper with step-by-step model answers."
>
  <div class="container page-padding">
    
    <!-- Hero Banner -->
    <div class="mock-test-hero">
      <div class="hero-content">
        <span class="badge badge-accent">🆕 AI Master Template Engine</span>
        <h1>MDU Authentic Mock Test Paper</h1>
        <p>Experience 100% pixel-perfect MDU Rohtak question paper layout. Test your preparation with step-by-step AI model solutions.</p>
      </div>
      
      <!-- Subject Switcher Pills -->
      <div class="mock-subjects-bar">
        <span class="switcher-label">Select Sample Mock Test:</span>
        <div class="switcher-pills">
          <a href="/mock-tests/" class="pill active">📊 DBMS (CSE-301-F)</a>
          <a href="/mock-tests/?subject=os" class="pill">💻 Operating Systems</a>
          <a href="/mock-tests/?subject=web" class="pill">🌐 Web Technologies</a>
          <a href="/mock-tests/?subject=math" class="pill">📐 Mathematics-III</a>
        </div>
      </div>
    </div>

    <!-- MDU Paper Renderer -->
    <MduPaperTemplate paper={dbmsMockPaper} />

  </div>
</BaseLayout>

<style>
  .page-padding {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .mock-test-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-8) auto;
  }

  .mock-test-hero h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    margin: var(--space-3) 0;
    background: linear-gradient(135deg, var(--text-primary), var(--accent-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .mock-test-hero p {
    color: var(--text-secondary);
    font-size: var(--text-md);
  }

  /* Subject Switcher */
  .mock-subjects-bar {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .switcher-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 700;
  }

  .switcher-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .pill {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .pill:hover {
    color: var(--text-primary);
    background: var(--glass-bg-hover);
    border-color: var(--glass-border-hover);
  }

  .pill.active {
    background: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-sm);
  }
</style>
