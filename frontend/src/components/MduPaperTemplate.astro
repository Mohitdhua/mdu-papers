---
interface SubQuestion {
  label: string;
  text: string;
  marks: number;
  solution?: string;
}

interface Question {
  id: number;
  qNum: string;
  title?: string;
  text?: string;
  subParts?: SubQuestion[];
  marks: number;
  solution?: string;
}

interface Section {
  name: string; // e.g. "Section A"
  note?: string;
  questions: Question[];
}

export interface PaperData {
  paperId: string;
  paperCode: string;
  rollNoBox?: boolean;
  totalPages: number;
  totalQuestions: number;
  degreeCourse: string; // e.g. "B.Tech. 5th Semester Examination"
  branch: string; // e.g. "Computer Science & Engineering"
  subjectName: string;
  paperName: string;
  examSession: string; // e.g. "December 2024"
  timeAllowed: string; // e.g. "3 Hours"
  maxMarks: number;
  compulsoryNote: string;
  sections: Section[];
}

interface Props {
  paper: PaperData;
}

const { paper } = Astro.props;
---

<div class="mdu-paper-wrapper">
  <!-- Interactive Action Controls (Hidden during Print) -->
  <div class="mdu-controls no-print">
    <div class="mdu-controls-left">
      <span class="mdu-badge">✨ AI Generated Model Test Paper</span>
      <span class="mdu-meta-tag">{paper.examSession}</span>
    </div>
    <div class="mdu-controls-right">
      <button type="button" class="btn btn-sm btn-outline" id="toggle-solutions-btn">
        💡 Show All AI Solutions
      </button>
      <button type="button" class="btn btn-sm btn-primary" onclick="window.print()">
        🖨️ Print / Download PDF
      </button>
    </div>
  </div>

  <!-- Official Pixel-Perfect MDU Exam Paper Container -->
  <article class="mdu-paper">
    
    <!-- Top Metadata Bar (Roll No & Pages) -->
    <div class="mdu-top-bar">
      <div class="mdu-pages-info">
        <span>Total No. of Pages: <strong>{paper.totalPages}</strong></span>
        <span>Total No. of Questions: <strong>{paper.totalQuestions}</strong></span>
      </div>
      
      <div class="mdu-roll-box">
        <span class="roll-label">Roll No.</span>
        <div class="roll-boxes">
          {Array.from({ length: 10 }).map(() => (
            <span class="roll-cell"></span>
          ))}
        </div>
      </div>
    </div>

    <!-- Paper Code & Unique Serial ID -->
    <div class="mdu-serial-header">
      <span class="paper-code">{paper.paperCode}</span>
      <span class="paper-id">({paper.paperId})</span>
    </div>

    <!-- Main University Header -->
    <header class="mdu-official-header">
      <h1 class="mdu-university-name">Maharshi Dayanand University, Rohtak</h1>
      <h2 class="mdu-exam-title">{paper.degreeCourse} ({paper.branch})</h2>
      <h3 class="mdu-session-title">Examination — {paper.examSession}</h3>
      <div class="mdu-subject-banner">
        <h4 class="mdu-subject-name">{paper.subjectName}</h4>
        {paper.paperName && <span class="mdu-paper-subname">Paper: {paper.paperName}</span>}
      </div>
    </header>

    <!-- Time & Max Marks Bar -->
    <div class="mdu-marks-time-bar">
      <div class="time-col">
        <span>Time Allowed: <strong>{paper.timeAllowed}</strong></span>
      </div>
      <div class="marks-col">
        <span>Maximum Marks: <strong>{paper.maxMarks}</strong></span>
      </div>
    </div>

    <!-- Compulsory Note Box -->
    <div class="mdu-note-box">
      <p class="note-heading">Note:</p>
      <p class="note-body">{paper.compulsoryNote}</p>
    </div>

    <!-- Divider Line -->
    <hr class="mdu-divider" />

    <!-- Paper Sections & Questions -->
    <div class="mdu-sections">
      {paper.sections.map((section, idx) => (
        <section class="mdu-section">
          <div class="mdu-section-header">
            <h5 class="section-title">{section.name}</h5>
            {section.note && <span class="section-note">({section.note})</span>}
          </div>

          <div class="mdu-questions-list">
            {section.questions.map((q) => (
              <div class="mdu-question-block" id={`q-${q.id}`}>
                <div class="mdu-question-header">
                  <div class="q-number">{q.qNum}.</div>
                  <div class="q-content">
                    {q.title && <p class="q-title">{q.title}</p>}
                    {q.text && <p class="q-text">{q.text}</p>}
                    
                    {/* Subparts (a, b, c, d) */}
                    {q.subParts && q.subParts.length > 0 && (
                      <div class="q-subparts">
                        {q.subParts.map((sub) => (
                          <div class="q-subpart">
                            <span class="sub-label">({sub.label})</span>
                            <span class="sub-text">{sub.text}</span>
                            <span class="sub-marks">[{sub.marks}]</span>
                            {sub.solution && (
                              <div class="q-solution sub-solution hidden">
                                <strong>💡 AI Model Answer:</strong>
                                <p>{sub.solution}</p>
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="q-marks-tag">
                    <span>[{q.marks}]</span>
                  </div>
                </div>

                {/* Main Question Solution Toggle (if any) */}
                {q.solution && (
                  <div class="q-solution-wrapper">
                    <button type="button" class="toggle-single-solution no-print" data-target={`sol-${q.id}`}>
                      Show Answer / Solution
                    </button>
                    <div class="q-solution hidden" id={`sol-${q.id}`}>
                      <strong>💡 AI Model Answer / Key Points:</strong>
                      <p>{q.solution}</p>
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Paper Footer Tag -->
    <footer class="mdu-paper-footer">
      <span class="mdu-end-tag">*** End of Question Paper ***</span>
      <span class="mdu-copyright">Generated by mdupapers.com AI Test Engine</span>
    </footer>
  </article>
</div>

<script>
  // Toggle all AI solutions
  let allVisible = false;
  const toggleBtn = document.getElementById('toggle-solutions-btn');
  toggleBtn?.addEventListener('click', () => {
    allVisible = !allVisible;
    const solutions = document.querySelectorAll('.q-solution');
    solutions.forEach((sol) => {
      if (allVisible) {
        sol.classList.remove('hidden');
      } else {
        sol.classList.add('hidden');
      }
    });
    if (toggleBtn) {
      toggleBtn.innerHTML = allVisible ? '🙈 Hide AI Solutions' : '💡 Show All AI Solutions';
    }
  });

  // Toggle single solution buttons
  const singleBtns = document.querySelectorAll('.toggle-single-solution');
  singleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (targetId) {
        const solEl = document.getElementById(targetId);
        const isOpen = solEl?.classList.toggle('hidden');
        btn.textContent = isOpen ? 'Show Answer / Solution' : 'Hide Answer';
      }
    });
  });
</script>

<style>
  .mdu-paper-wrapper {
    max-width: 850px;
    margin: 0 auto;
    padding: var(--space-4) 0;
  }

  /* Controls Top Bar */
  .mdu-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-5);
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .mdu-controls-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mdu-badge {
    background: var(--accent-primary-light);
    color: var(--accent-primary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .mdu-meta-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 600;
  }

  .mdu-controls-right {
    display: flex;
    gap: var(--space-3);
  }

  /* ============================================================
     OFFICIAL MDU EXAM PAPER STYLING (Pixel-Perfect Authentic)
     ============================================================ */
  .mdu-paper {
    background: #ffffff;
    color: #111111;
    font-family: 'Times New Roman', Times, serif;
    padding: 40px 50px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    line-height: 1.5;
  }

  /* Top Metadata & Roll No Box */
  .mdu-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .mdu-pages-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mdu-roll-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .roll-label {
    font-weight: bold;
    font-size: 14px;
  }

  .roll-boxes {
    display: flex;
    gap: 0;
  }

  .roll-cell {
    width: 20px;
    height: 24px;
    border: 1px solid #000;
    border-right: none;
    background: #fff;
  }

  .roll-cell:last-child {
    border-right: 1px solid #000;
  }

  /* Paper Serial & ID */
  .mdu-serial-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    font-size: 16px;
    margin-bottom: 16px;
    font-family: Arial, sans-serif;
  }

  /* Official Header */
  .mdu-official-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .mdu-university-name {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    color: #000;
  }

  .mdu-exam-title {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 2px;
    color: #222;
  }

  .mdu-session-title {
    font-size: 14px;
    font-style: italic;
    margin-bottom: 12px;
    color: #333;
  }

  .mdu-subject-name {
    font-size: 18px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: underline;
    margin-bottom: 2px;
  }

  .mdu-paper-subname {
    font-size: 14px;
    font-weight: bold;
  }

  /* Marks & Time Bar */
  .mdu-marks-time-bar {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    font-weight: bold;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    padding: 6px 0;
    margin-bottom: 16px;
  }

  /* Note Box */
  .mdu-note-box {
    font-size: 13px;
    margin-bottom: 16px;
  }

  .note-heading {
    font-weight: bold;
    font-style: italic;
    display: inline;
    margin-right: 6px;
  }

  .note-body {
    display: inline;
    font-style: italic;
  }

  .mdu-divider {
    border: none;
    border-top: 1px solid #666;
    margin: 16px 0 24px 0;
  }

  /* Sections & Questions */
  .mdu-sections {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mdu-section-header {
    text-align: center;
    margin-bottom: 14px;
  }

  .section-title {
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    text-decoration: underline;
    display: inline-block;
  }

  .section-note {
    font-size: 13px;
    font-style: italic;
    margin-left: 8px;
  }

  /* Question Item Block */
  .mdu-questions-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .mdu-question-block {
    font-size: 15px;
  }

  .mdu-question-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .q-number {
    font-weight: bold;
    min-width: 28px;
  }

  .q-content {
    flex: 1;
  }

  .q-title {
    font-weight: bold;
    margin-bottom: 4px;
  }

  .q-text {
    margin-bottom: 8px;
  }

  .q-subparts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
    padding-left: 10px;
  }

  .q-subpart {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14.5px;
  }

  .sub-label {
    font-weight: bold;
    min-width: 24px;
  }

  .sub-text {
    flex: 1;
  }

  .sub-marks {
    font-weight: bold;
    min-width: 32px;
    text-align: right;
  }

  .q-marks-tag {
    font-weight: bold;
    min-width: 40px;
    text-align: right;
    font-size: 14px;
  }

  /* Solution Box */
  .q-solution-wrapper {
    margin-top: 8px;
    margin-left: 40px;
  }

  .toggle-single-solution {
    background: #eef2ff;
    color: #4f46e5;
    border: 1px solid #c7d2fe;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--font-sans, sans-serif);
    transition: background 0.15s ease;
  }

  .toggle-single-solution:hover {
    background: #e0e7ff;
  }

  .q-solution {
    margin-top: 8px;
    padding: 12px 16px;
    background: #f8fafc;
    border-left: 4px solid #6366f1;
    border-radius: 4px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13.5px;
    color: #1e293b;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.04);
  }

  .q-solution strong {
    color: #4338ca;
    display: block;
    margin-bottom: 4px;
  }

  .sub-solution {
    margin-left: 32px;
    margin-top: 4px;
    width: 100%;
  }

  /* Paper Footer */
  .mdu-paper-footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px dashed #aaa;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: bold;
  }

  .mdu-end-tag {
    letter-spacing: 1px;
  }

  .mdu-copyright {
    font-size: 11px;
    color: #666;
    font-weight: normal;
    font-family: Arial, sans-serif;
  }

  /* ============================================================
     PRINT STYLESHEET (Pixel-Perfect Print Output)
     ============================================================ */
  @media print {
    body {
      background: #fff !important;
      color: #000 !important;
    }

    .no-print,
    .site-header,
    .site-footer,
    .mdu-controls,
    .toggle-single-solution {
      display: none !important;
    }

    .mdu-paper-wrapper {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .mdu-paper {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    .q-solution {
      border-left-color: #000 !important;
      background: #f1f5f9 !important;
    }
  }
</style>
